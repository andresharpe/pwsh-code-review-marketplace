# Per-project review state generated by /pwsh-review-bootstrap and /pwsh-review.
# These belong inside the consuming project repo, not in the plugin source.
# The leading `**/` is required to match the cache when a script resolves
# RepoRoot to the plugin directory (e.g. plugins/pwsh-code-review/.pwsh-review/cache/)
# instead of the repo root.
.pwsh-review/cache/
.pwsh-review/cache/**
**/.pwsh-review/cache/
**/.pwsh-review/cache/**

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Test output
TestResults/
test-results/
*.trx

# PowerShell module artefacts
*.zip
